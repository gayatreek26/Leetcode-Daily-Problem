from typing import List

class Solution:
    def lexicographicallySmallestArray(self, nums: List[int], limit: int) -> List[int]:
        
        n = len(nums)

        # Store (value, original_index)
        arr = sorted((num, i) for i, num in enumerate(nums))

        ans = [0] * n

        i = 0

        while i < n:
            j = i + 1

            # Find all elements belonging to the same group
            while j < n and arr[j][0] - arr[j - 1][0] <= limit:
                j += 1

            # Original indices of this group
            indices = sorted(index for _, index in arr[i:j])

            # Values are already sorted because arr is sorted
            for index, (value, _) in zip(indices, arr[i:j]):
                ans[index] = value

            i = j

        return ans
