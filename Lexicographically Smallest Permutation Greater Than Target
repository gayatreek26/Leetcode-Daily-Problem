class Solution:
    def lexGreaterPermutation(self, s: str, target: str) -> str:
        n = len(s)

        # Frequency of characters in s
        count = [0] * 26

        for ch in s:
            count[ord(ch) - ord('a')] += 1

        # Try to match target from right to left
        for i in range(n - 1, -1, -1):

            # Check whether target[:i] can be formed
            remaining = count[:]

            possible = True

            for j in range(i):
                idx = ord(target[j]) - ord('a')

                if remaining[idx] == 0:
                    possible = False
                    break

                remaining[idx] -= 1

            if not possible:
                continue

            # At position i, choose the smallest
            # character greater than target[i]
            target_idx = ord(target[i]) - ord('a')

            for c in range(target_idx + 1, 26):

                if remaining[c] > 0:
                    # Use this bigger character
                    remaining[c] -= 1

                    ans = target[:i] + chr(c + ord('a'))

                    # Put remaining characters in sorted order
                    for x in range(26):
                        ans += chr(x + ord('a')) * remaining[x]

                    return ans

        return ""
